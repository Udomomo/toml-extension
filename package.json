{
  "name": "toml-extension",
  "displayName": "TOML Extension",
  "description": "TOML language support powered by a TypeScript Language Server.",
  "version": "0.0.1",
  "publisher": "toml-extension",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Udomomo/toml-extension"
  },
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:toml"
  ],
  "main": "./out/client/extension.js",
  "imports": {
    "#analyzer": {
      "types": "./out/analyzer/index.d.ts",
      "default": "./out/analyzer/index.js"
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "toml",
        "aliases": [
          "TOML",
          "toml"
        ],
        "extensions": [
          ".toml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "TOML Extension",
      "properties": {
        "tomlExtension.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace communication between the TOML Extension and its Language Server."
        }
      }
    },
    "commands": [
      {
        "command": "tomlExtension.restartLanguageServer",
        "title": "TOML: Restart Language Server"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -b",
    "test": "npm run test:unit && npm run test:conformance",
    "test:unit": "tsx --test analyzer/test/analyze.test.ts",
    "test:conformance": "tsx --test analyzer/test/conformance.test.ts",
    "check-types": "tsc -b --pretty && tsc -p tsconfig.test.json --pretty",
    "watch": "tsc -b -w",
    "package": "npm run compile && vsce package",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "toml": "5.0.0",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11"
  },
  "devDependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@types/node": "^20.14.2",
    "@types/vscode": "^1.92.0",
    "@vscode/vsce": "^3.9.2",
    "tsx": "^4.23.13",
    "typescript": "^5.4.5"
  }
}
